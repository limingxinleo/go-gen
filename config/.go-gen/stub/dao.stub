package dao

import (
    "context"
    "github.com/zeromicro/go-zero/core/logx"
	"github.com/zeromicro/go-zero/core/stores/sqlx"
)

type {name} struct {
	sqlConn sqlx.SqlConn
	ctx     context.Context
	log     logx.Logger
}

func New{name}(sqlConn sqlx.SqlConn, ctx context.Context) *{name} {
	return &{name}{
		sqlConn: sqlConn,
		ctx:     ctx,
		log:     logx.WithContext(ctx),
	}
}
